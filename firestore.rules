rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Get CRM user data (from 'users' collection)
    function getCRMUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if authenticated user exists in CRM 'users' collection
    function isCRMUser() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Check if user has a specific role in CRM
    function hasRole(role) {
      return isCRMUser() && getCRMUserData().role == role;
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Check if user is app manager
    function isAppManager() {
      return hasRole('appManager');
    }

    // Check if user can manage app (admin or appManager)
    function canManageApp() {
      return isAdmin() || isAppManager();
    }

    // Check if authenticated user exists in 'AppUsers' collection (mobile app users)
    function isAppUser() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/AppUsers/$(request.auth.uid));
    }

    // ========================================
    // CRM COLLECTIONS (Only for CRM staff)
    // ========================================
    
    // Users collection - ONLY for CRM staff
    match /users/{userId} {
      // Only CRM users can read their own profile or admins can read any
      allow read: if isCRMUser() && (request.auth.uid == userId || isAdmin());
      allow write: if isCRMUser() && (request.auth.uid == userId || isAdmin());
    }

    // Employees (Management of staff)
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // Banks (Configuration for payments)
    match /banks/{bankId} {
      allow read: if isCRMUser(); // Only CRM staff can see banks
      allow write: if isAdmin();
    }

    // Restaurant Configuration
    match /config/restaurant {
      allow read: if isCRMUser();
      allow write: if isAdmin();
    }
    
    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || hasRole('employee');
    }
    
    // Daily Data (Cash reporting)
    match /dailyData/{dateId} {
       allow read: if isAdmin() || hasRole('employee');
       allow write: if isAdmin();
    }
    
    // Daily Stats (Aggregated revenue from POS)
    match /daily_stats/{dateId} {
       allow read: if isAdmin();
       allow write: if isCRMUser(); // Only CRM users can update stats
    }
    
    // Orders (POS Orders)
    match /orders/{orderId} {
       allow read: if isCRMUser(); // CRM users can read orders for stats/history
       allow write: if isCRMUser(); // CRM users can create/update orders
    }
    
    // Menu Items (Restaurant Menu)
    match /menu_items/{itemId} {
       allow read: if true; // Public read for menu display
       allow write: if isAdmin(); // Only admins can modify menu
    }
    
    // CRM Menu (Denormalized POS Menu)
    match /CrmMenu/fullMenu {
       allow read: if isCRMUser(); // All CRM users can read menu
       allow write: if isAdmin(); // Only admins can modify menu
    }

    // App Daily Stats (Aggregated revenue from mobile app)
    match /app_daily_stats/{dateId} {
       allow read: if canManageApp(); // Admin or appManager can view app stats
       allow write: if isCRMUser(); // CRM users update when processing app orders
    }
    
    // Tables (Status management)
    match /tables/{tableId} {
       allow read, write: if isCRMUser();
    }
    
    // Expense Categories Config (single document with map)
    match /expense_categories/config {
       allow read: if isAdmin() || hasRole('employee');
       allow write: if isAdmin();
    }
    
    // Expense Categories - Individual documents (legacy, for migration only)
    match /expense_categories/{categoryId} {
       allow read: if isAdmin(); // Solo admin puede leer documentos individuales (para migración)
       allow write: if false; // No permitir escritura en documentos individuales
    }
    
    // Inventory & Components
    match /inventory_items/{itemId} {
       allow read, write: if isAdmin();
    }

    match /inventory_categories/{categoryId} {
       allow read, write: if isAdmin();
    }

    match /inventory_movements/{movementId} {
       allow read, write: if isAdmin();
    }
    
    // CRM Orders (Kitchen/Waiter orders)
    match /orders/{orderId} {
      allow read, write: if isCRMUser();
    }

    // Menu Management (CRM only)
    match /categories/{categoryId} {
      allow read: if isCRMUser();
      allow write: if isAdmin();
    }
    
    match /items/{itemId} {
      allow read: if isCRMUser();
      allow write: if isAdmin();
    }

    match /menu/{menuId} {
      allow read: if isCRMUser();
      allow write: if isAdmin();
    }

    // ========================================
    // MOBILE APP COLLECTIONS (Public/App Users)
    // ========================================

    // AppMenu: Public read access for the mobile app
    match /AppMenu/{menuId} {
      allow read: if true; // Anyone can read the menu
      allow write: if canManageApp(); // Admin or appManager can update
    }

    // AppConfig: Configuration for mobile app (zones, settings, etc.)
    match /AppConfig/{document} {
      allow read: if true; // Public read for app to load zones
      allow write: if canManageApp(); // Admin or appManager can modify config
    }

    // AppUsers: Mobile app user profiles
    match /AppUsers/{userId} {
      // Users can only read/write their own profile
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Admin or appManager can read all app user profiles (for customer service)
      allow read: if canManageApp();
    }

    // AppUsers Addresses sub-collection
    match /AppUsers/{userId}/addresses/{addressId} {
      // Users can read/write their own addresses
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Admin or appManager can read (for delivery purposes)
      allow read: if canManageApp();
    }

    // AppOrders: Orders placed from mobile app
    match /AppOrders/{orderId} {
      // App users can create orders
      allow create: if isAppUser();
      
      // App users can read their own orders
      allow read: if isSignedIn() && resource.data.customerId == request.auth.uid;
      
      // Admin or appManager can read/update all orders
      allow read, update: if canManageApp();
      
      // Only admin or appManager can delete orders
      allow delete: if canManageApp();
    }

    // ========================================
    // FALLBACK (Deny all other access)
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
