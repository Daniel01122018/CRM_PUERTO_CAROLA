rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get the current user's data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if the user has a specific role
    function hasRole(role) {
      return getUserData().role == role;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Users collection rules
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // --- Phase 2: Admin Module ---
    
    // Employees (Management of staff)
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // Banks (Configuration for payments)
    match /banks/{bankId} {
      allow read: if request.auth != null; // Waiters need to see banks for payments
      allow write: if isAdmin();
    }

    // Restaurant Configuration (e.g. Table count)
    match /config/restaurant {
      allow read: if request.auth != null; // Staff needs to know table count
      allow write: if isAdmin();
    }
    
    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Daily Data (Cash reporting)
    match /dailyData/{dateId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }
    
    // Daily Stats (Aggregated revenue)
    match /daily_stats/{dateId} {
       allow read: if isAdmin();
       // Employees update stats when completing orders. 
       // Ideally we'd use a cloud function, but for now we allow authenticated writes.
       allow write: if request.auth != null; 
    }
    
    // Tables (Status management)
    match /tables/{tableId} {
       allow read: if request.auth != null; // Waiters need to see table status
       allow write: if request.auth != null; // Waiters lock/unlock tables
    }
    
    // Expense Categories
    match /expense_categories/{categoryId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }
    
    // Expense Categories
    match /expense_categories/{categoryId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }
    
    // Inventory & Components
    match /inventory_items/{itemId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }

    match /inventory_categories/{categoryId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }

    match /inventory_movements/{movementId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }
    
    // --- Phase 3: Kitchen Module ---
    
    // Orders (Kitchen needs read access and status updates)
    match /orders/{orderId} {
      allow read: if request.auth != null; // Waiters, Kitchen, Admin all need to read
      allow create: if request.auth != null; // Waiters create orders
      // Allow update if admin OR if kitchen updating specific fields (like status) OR waiter updating own order
      // For simplicity in this phase, we allow authenticated write, but ideally we'd restrict fields.
      allow write: if request.auth != null; 
    }

    // --- Phase 4: Interim Rules (Menu) ---
    // The app uses root collections 'categories' and 'items' for the menu
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Legacy/Placeholder (Safe to keep if unsure, but likely unused based on hook analysis)
    match /menu/{menuId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Fallback
    match /{document=**} {
      allow read: if request.auth != null; 
      allow write: if false; 
    }
  }
}
